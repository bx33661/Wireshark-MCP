{
  "schema_version": 1,
  "suite": "agent-traffic-analysis",
  "scenarios": [
    {
      "id": "T01_capture_packet_count",
      "category": "fact",
      "capture": "tests/fixtures/pcaps/plaintext_credentials.pcap",
      "prompt": "这个抓包中有多少个数据包？",
      "expected_conclusion": "confirmed",
      "expected_facts": {
        "packet_count": 3
      },
      "allowed_coverage": [
        "complete"
      ],
      "evidence": {
        "min_anchors": 1,
        "accepted_types": [
          "aggregate",
          "query"
        ],
        "query_required": true
      },
      "forbidden_claims": [
        "malware",
        "compromised"
      ]
    },
    {
      "id": "T02_capture_primary_source",
      "category": "fact",
      "capture": "tests/fixtures/pcaps/plaintext_credentials.pcap",
      "prompt": "哪个源 IP 发送的数据包最多？给出数量和查询依据。",
      "expected_conclusion": "confirmed",
      "expected_facts": {
        "primary_source": "192.168.1.10",
        "primary_source_packets": 3
      },
      "allowed_coverage": [
        "complete"
      ],
      "evidence": {
        "min_anchors": 1,
        "accepted_types": [
          "aggregate"
        ],
        "query_required": true
      },
      "forbidden_claims": [
        "attacker"
      ]
    },
